// 📚 LESSON: Firebase Security Rules
// These rules control WHO can read/write data in your database.
// Without rules, ANYONE can read/write your appointments data!
//
// HOW TO DEPLOY:
// 1. Install Firebase CLI: npm install -g firebase-tools
// 2. Run: firebase login
// 3. Run: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Appointments collection:
    // Anyone can CREATE (patients submitting forms)
    // Only authenticated admin can READ (you checking appointments)
    match /appointments/{appointmentId} {
      // ✅ Anyone can write (submit an appointment form)
      allow create: if
        // Validate required fields exist
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.treatment is string;

      // ❌ Only authenticated users (you, via Firebase Auth) can read
      allow read, update, delete: if request.auth != null;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
