# 📚 LESSON: .gitignore tells Git which files NOT to upload to GitHub.
# The most important: .env.local (contains Firebase keys — keep these secret!)

# Dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/

# Environment files — NEVER commit these to GitHub!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment files
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
